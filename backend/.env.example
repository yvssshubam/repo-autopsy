# --- GitHub -----------------------------------------------------
# No scopes needed for public repositories. It only raises the rate
# limit from 60 requests an hour to 5,000.
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Only needed if the frontend is served from a different origin than
# the API. Running uvicorn alone, leave this commented out.
# ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Refuse source analysis once GitHub's hourly quota drops this low,
# so the structural views keep working for the rest of the hour.
GITHUB_RESERVE=250


# --- Models (optional) ------------------------------------------
# Leave GROQ_API_KEY empty to run without summaries or task impact.
# Everything else still works. https://console.groq.com/keys
GROQ_API_KEY=

SUMMARY_MODEL=openai/gpt-oss-20b
REPO_MODEL=openai/gpt-oss-120b

# The agent needs reliable tool calling. gpt-oss intermittently writes
# prose where a tool call belongs, which Groq's parser rejects, so
# qwen is the better default here.
AGENT_MODEL=qwen/qwen3.8-27b

# Stop calling the model before the provider's daily cap is reached.
# Roughly: 200K daily tokens divided by ~700 per summary.
DAILY_CALL_BUDGET=250


# --- Task impact agent ------------------------------------------
# The binding limit is input tokens per minute, counted across every
# call in that minute rather than per request. Six steps plus the
# final report lands near 4,500, inside qwen's 7,000.
AGENT_MAX_STEPS=6
AGENT_MAX_READS=10
AGENT_TOKEN_BUDGET=5000

# Wait out a mid-run rate limit rather than abandoning the run.
AGENT_MAX_WAITS=2
AGENT_MAX_WAIT_SECONDS=25


# --- Per-client rate limits -------------------------------------
# Per minute, per day. Tighten these if you expose the app publicly.
SUMMARY_RPM=12
SUMMARY_RPD=120
GITHUB_RPM=45
GITHUB_RPD=800
CHEAP_RPM=120
CHEAP_RPD=4000
AGENT_RPM=3
AGENT_RPD=25

# Set to true ONLY behind a proxy that sets X-Forwarded-For.
# Otherwise clients can spoof their own identity.
TRUST_PROXY=false