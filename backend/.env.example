# Copy this file to backend/.env and fill in the token.
# Never commit the real .env.
#
# A personal access token needs no scopes for public repositories.
# It only raises the GitHub rate limit from 60 requests an hour to
# 5,000. Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Only needed if you serve the frontend from a different origin than
# the API. Running uvicorn alone, you can leave this out entirely.
# ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500